<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_circle_button"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_coins"
        style="@style/Ur.Widget.Material3.Button.IconButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:text="@string/dollar_sign"
        android:textColor="#FDE918"
        android:textSize="20sp"
        android:background="@color/anythink_cm_color_999999"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 右上角金币数 -->
    <TextView
        android:id="@+id/tv_coins_nums"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100"
        android:textColor="#FDE918"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/tv_coins"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/main_dollar_stroke"
        app:layout_constraintBottom_toBottomOf="@+id/tv_coins"
        app:layout_constraintEnd_toEndOf="@+id/tv_coins"
        app:layout_constraintStart_toStartOf="@+id/tv_coins"
        app:layout_constraintTop_toTopOf="@+id/tv_coins" />
</androidx.constraintlayout.widget.ConstraintLayout>