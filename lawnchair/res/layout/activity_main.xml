<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="320dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_stats_container">

        <FrameLayout
            android:id="@+id/banner_ad_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- 左上角图标 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_profile"
        style="@style/Ur.Widget.Material3.Button.IconButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:icon="@drawable/main_profile_entry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/coin_circle_button"
        layout="@layout/coin_circel_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/main_heart_circle_4"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:src="@drawable/main_heart_draw_back_4"
        app:layout_constraintBottom_toBottomOf="@+id/main_heart"
        app:layout_constraintEnd_toEndOf="@+id/main_heart"
        app:layout_constraintStart_toStartOf="@+id/main_heart"
        app:layout_constraintTop_toTopOf="@+id/main_heart" />

    <ImageView
        android:id="@+id/main_heart_circle_3"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:src="@drawable/main_heart_draw_back_4"
        app:layout_constraintBottom_toBottomOf="@+id/main_heart"
        app:layout_constraintEnd_toEndOf="@+id/main_heart"
        app:layout_constraintStart_toStartOf="@+id/main_heart"
        app:layout_constraintTop_toTopOf="@+id/main_heart" />

    <ImageView
        android:id="@+id/main_heart_circle_2"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/main_heart_draw_back_4"
        app:layout_constraintBottom_toBottomOf="@+id/main_heart"
        app:layout_constraintEnd_toEndOf="@+id/main_heart"
        app:layout_constraintStart_toStartOf="@+id/main_heart"
        app:layout_constraintTop_toTopOf="@+id/main_heart" />

    <ImageView
        android:id="@+id/main_heart_circle_1"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/main_heart_draw_back_4"
        app:layout_constraintBottom_toBottomOf="@+id/main_heart"
        app:layout_constraintEnd_toEndOf="@+id/main_heart"
        app:layout_constraintStart_toStartOf="@+id/main_heart"
        app:layout_constraintTop_toTopOf="@+id/main_heart" />

    <ImageView
        android:id="@+id/main_heart"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/main_heart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <ImageView
        android:id="@+id/main_shoes"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/main_shoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_profile"
        app:layout_constraintVertical_bias="0.5" />
    <!-- 中心步数显示 -->
    <TextView
        android:id="@+id/tv_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/steps_count"
        android:textColor="?attr/colorOnBackground"
        android:textSize="80sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/main_heart"
        app:layout_constraintStart_toStartOf="@+id/main_heart"
        app:layout_constraintTop_toBottomOf="@+id/main_shoes"
        app:layout_constraintVertical_bias="0.45" />

    <ImageView
        android:id="@+id/icon_treasure"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/task_done_icon_treasure_close"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_steps"
        app:layout_constraintTop_toTopOf="@+id/tv_steps" />

    <TextView
        android:id="@+id/tv_daily_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/daily_steps"
        android:textColor="?attr/colorOnBackground"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/main_heart"
        app:layout_constraintStart_toStartOf="@+id/main_heart"
        app:layout_constraintTop_toBottomOf="@+id/tv_steps" />

    <!-- 图表按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_chart"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:icon="@drawable/baseline_insert_chart_outlined_24"
        app:iconTint="?attr/colorOnBackground"
        app:layout_constraintEnd_toEndOf="@+id/main_heart"
        app:layout_constraintStart_toStartOf="@+id/main_heart"
        app:layout_constraintTop_toBottomOf="@+id/tv_daily_steps" />

    <!-- 底部数据显示区域 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_stats_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_heart_circle_4">

        <!-- 距离数据 -->
        <TextView
            android:id="@+id/tv_distance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_distance_value"
            android:textColor="?attr/colorOnBackground"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_calories_value"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_distance_unit"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_distance_value"
            app:layout_constraintStart_toStartOf="@+id/tv_distance_value"
            app:layout_constraintTop_toBottomOf="@+id/tv_distance_value" />

        <!-- 卡路里数据 -->
        <TextView
            android:id="@+id/tv_calories_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_calories_value"
            android:textColor="?attr/colorOnBackground"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_time_value"
            app:layout_constraintStart_toEndOf="@+id/tv_distance_value"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_calories_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_calories_unit"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_calories_value"
            app:layout_constraintStart_toStartOf="@+id/tv_calories_value"
            app:layout_constraintTop_toBottomOf="@+id/tv_calories_value" />

        <!-- 时间数据 -->
        <TextView
            android:id="@+id/tv_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_duration_value"
            android:textColor="?attr/colorOnBackground"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_calories_value"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_time_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_duration_unit"
            android:textColor="?attr/colorOnBackground"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_time_value"
            app:layout_constraintStart_toStartOf="@+id/tv_time_value"
            app:layout_constraintTop_toBottomOf="@+id/tv_time_value" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 底部提示文本改为按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_earn_coins"
        style="@style/Ur.Widget.Material3.Button.EarnCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/earn_coins"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_daily_steps" />

    <FrameLayout
        android:id="@+id/display_inspiration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottom_stats_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/coin_inspiration_button" />

    </FrameLayout>

    <!-- 任务1：走1000米 -->
    <FrameLayout
        android:id="@+id/layout_task_first_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_stats_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/layout_task_first"
            layout="@layout/item_coin_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 关闭按钮 -->
        <ImageView
            android:id="@+id/btn_close_task_container"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_close"
            android:elevation="2dp"
            app:tint="?attr/colorOnSurface" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 