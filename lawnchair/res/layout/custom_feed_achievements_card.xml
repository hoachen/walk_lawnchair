<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Card Background matching App Grid and Task Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/app_grid_background"
        android:backgroundTint="#40FFFFFF"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/achievements_title"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/achievements_subtitle"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Achievements List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:divider="@drawable/divider_achievement"
            android:showDividers="middle"
            android:dividerPadding="8dp">

            <!-- Achievement 1 -->
            <LinearLayout
                android:id="@+id/achievement1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/achievement1_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="🔥"
                    android:textSize="14sp"
                    android:background="@drawable/achievement_icon_background"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/achievement1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Title 1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/achievement1_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Description 1"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/achievement1_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Tag 1"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:background="@drawable/achievement_tag_background" 
                    android:backgroundTint="#4DFFFFFF"/> 
            </LinearLayout>

            <!-- Achievement 2 -->
            <LinearLayout
                android:id="@+id/achievement2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/achievement2_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="🏅"
                    android:textSize="14sp"
                    android:background="@drawable/achievement_icon_background"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/achievement2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Title 2"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/achievement2_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Description 2"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/achievement2_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Tag 2"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:background="@drawable/achievement_tag_background"
                    android:backgroundTint="#4DFFFFFF" />
            </LinearLayout>

            <!-- Achievement 3 -->
            <LinearLayout
                android:id="@+id/achievement3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/achievement3_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:text="🎯"
                    android:textSize="14sp"
                    android:background="@drawable/achievement_icon_background"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/achievement3_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Title 3"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/achievement3_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Description 3"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/achievement3_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Tag 3"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:background="@drawable/achievement_tag_background"
                    android:backgroundTint="#4DFFFFFF" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
