<?xml version="1.0" encoding="utf-8"?>
<!--
  Two independent native hosts, matching the reference All Apps adapter.  They start hidden;
  AdManager makes each host visible only when its placement has loaded and is eligible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/all_apps_native_ad_container_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/all_apps_native_ad_container_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
