<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- 用户头像 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_avatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="?attr/colorSurfaceVariant"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearance.WalkApp.Circle"
        app:srcCompat="@android:drawable/ic_menu_gallery"
        app:strokeWidth="2dp" />

    <ImageView
        android:id="@+id/plus_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/profile_plus"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar" />

    <!-- 昵称文本 -->
    <TextView
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/set_nickname"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_avatar" />

    <ImageView
        android:id="@+id/plus_nick_name"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/profile_plus"
        app:layout_constraintBottom_toBottomOf="@+id/tv_nickname"
        app:layout_constraintStart_toEndOf="@+id/tv_nickname"
        app:layout_constraintTop_toTopOf="@+id/tv_nickname" />

    <!-- 用户信息图标容器 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_nickname">

        <!-- 性别图标 -->
        <ImageView
            android:id="@+id/iv_gender"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="50dp"
            app:srcCompat="@drawable/profile_gender"
            app:tint="@color/md_theme_onSurface" />

        <!-- 身高图标 -->
        <ImageView
            android:id="@+id/iv_height"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="50dp"
            app:srcCompat="@drawable/profile_height"
            app:tint="@color/md_theme_onSurface" />

        <!-- 体重图标 -->
        <ImageView
            android:id="@+id/iv_weight"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:srcCompat="@drawable/profile_kg"
            app:tint="@color/md_theme_onSurface" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
