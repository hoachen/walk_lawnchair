<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/profile_running_cornor" />
    <!-- 顶部工具栏 -->
    <include
        android:id="@+id/layout_toolbar"
        layout="@layout/include_profile_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 用户信息区域 -->
    <include
        android:id="@+id/layout_user_info"
        layout="@layout/include_user_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layout_toolbar" />

    <!-- 步数统计区域 -->
    <include
        android:id="@+id/layout_step_stats"
        layout="@layout/include_step_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/layout_user_info" />

    <!--    &lt;!&ndash; 底部信息区域 &ndash;&gt;-->
    <!--    <include-->
    <!--        android:id="@+id/layout_bottom_info"-->
    <!--        layout="@layout/include_bottom_info"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent" />-->

</androidx.constraintlayout.widget.ConstraintLayout>
