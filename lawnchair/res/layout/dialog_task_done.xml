<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/global_dialog_width"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|center_vertical">

    <ImageView
        android:id="@+id/top_crown"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:layout_marginTop="30dp"
        android:scaleType="centerInside"
        android:src="@drawable/task_done_top_crown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/task_done_icon_treasure"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:scaleType="fitCenter"
        android:src="@drawable/task_done_icon_treasure_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_crown" />

    <TextView
        android:id="@+id/task_done_coin_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task_done_coins"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/task_done_icon_treasure" />

    <TextView
        android:id="@+id/task_done_coin_as_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task_done_coins"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/task_done_coin_count" />

    <TextView
        android:id="@+id/task_done_watch_ad_video"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/task_done_watch_ad_video"
        android:gravity="center"
        android:textSize="18sp"
        android:scaleType="fitCenter"
        android:text="@string/rewatch_ad_double"
        android:paddingStart="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/task_done_coin_as_money" />

    <ImageView
        android:id="@+id/task_done_ad_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="15dp"
        android:layout_marginBottom="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/task_done_ad_icon"
        app:layout_constraintBottom_toBottomOf="@+id/task_done_watch_ad_video"
        app:layout_constraintStart_toStartOf="@+id/task_done_watch_ad_video"
        app:layout_constraintTop_toTopOf="@+id/task_done_watch_ad_video" />

    <TextView
        android:id="@+id/task_done_claim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/claim"
        android:textColor="?attr/colorOnBackground"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/task_done_ad_icon" />


    <FrameLayout
        android:id="@+id/banner_ad_view_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/task_done_claim" />
</androidx.constraintlayout.widget.ConstraintLayout>
