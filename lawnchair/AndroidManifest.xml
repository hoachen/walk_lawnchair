            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustPan" />

        <activity
            android:name="com.ur.apps.walk.WithdrawalRecordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WalkApp.Theme1" />

        <activity
            android:name="com.ur.apps.walk.WebViewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.WalkApp.Theme1" />

        <!-- 权限请求页面 -->
        <activity
            android:name="com.ur.apps.walk.PermissionRequestActivity"
            android:exported="false"
            android:theme="@style/Theme.WalkApp.Theme1" />

        <!-- 锁屏界面 -->
        <activity
            android:name="com.ur.apps.walk.LockScreenActivity"
            android:configChanges="orientation|keyboard"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="com.cashwalk.cashwalk.lockscreen.LockScreenActivity"
            android:theme="@style/LockScreenTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <service
            android:name="com.ur.apps.walk.step.service.StepService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|health" />


        <meta-data
            android:name="design_width_in_dp"
            android:value="411" />
