    <application
        android:name="com.ur.apps.walk.WalkApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        tools:targetApi="31"
        android:backupAgent="com.android.launcher3.LauncherBackupAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backupscheme"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme"
        android:largeHeap="@bool/config_largeHeap"
        tools:replace="android:fullBackupContent,android:allowBackup"
        android:restoreAnyVersion="true">


        <uses-library android:name="org.apache.http.legacy" android:required="false" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2830772598550207~1093153378"/>

        <meta-data
            android:name="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value="true" />

        <!-- source file: nonchina_jcenter/network_sdk/inmobi/10.8.0/AndroidManifest.xml -->
        <!--android:networkSecurityConfig="@xml/network_security_config"-->

        <!-- source file: nonchina_jcenter/network_sdk/yandex/7.10.0/AndroidManifest.xml -->
        <!-- Disable automatic sdk initialization for yandex -->
        <meta-data
            android:name="com.yandex.mobile.ads.AUTOMATIC_SDK_INITIALIZATION"
            android:value="false" />
        <!-- source file: nonchina_jcenter/network_sdk/fyber/8.3.5/AndroidManifest.xml -->

        <!-- FileProvider配置 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities"
            >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource"
                />
        </provider>

        <!-- 启动页Activity -->
        <activity
            android:name="com.ur.apps.walk.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.WalkApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ur.apps.walk.MainActivityRecycler"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WalkApp.Theme1" />

        <activity
            android:name="com.ur.apps.walk.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.WalkApp.Theme1" />

        <activity
