            android:screenOrientation="portrait" />

        <activity
            android:name="com.ur.apps.walk.TrendsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WalkApp.Theme1" />

        <activity
            android:name="com.ur.apps.walk.CoinTaskActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
