<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 玻璃拟态背景：半透明白色带模糊效果 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" /> <!-- rgba(255,255,255,0.08) -->
            <corners android:radius="28dp" />
            <stroke 
                android:width="1dp"
                android:color="#26FFFFFF" /> <!-- rgba(255,255,255,0.15) -->
        </shape>
    </item>
</layer-list>
