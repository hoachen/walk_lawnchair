<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.WalkApp.Circle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Ur.Widget.Material3.Button.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">30dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>


    <style name="Ur.Widget.Material3.Button.EarnCoins" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">30dp</item>
        <item name="iconTint">?attr/colorOnBackground</item>
        <item name="strokeColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="backgroundTint">?attr/colorOnPrimary</item>
    </style>

    <style name="Ur.Widget.Material3.Button.EarnCoinsNoIcons" parent="Widget.Material3.Button.OutlinedButton">
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">0dp</item>
        <item name="iconTint">?attr/colorOnTertiary</item>
        <item name="strokeColor">?attr/colorOnTertiary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorOnTertiary</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 添加自定义对话框样式 -->
    <style name="CustomDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Ur.Widget.Material3.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">50dp</item>
        <item name="backgroundColor">?attr/colorPrimary</item>
        <item name="background">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>

    </style>

    <style name="CustomToggleButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@color/toggle_text_color</item>
        <item name="backgroundTint">@color/toggle_bg_color</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="RoundedImageViewShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50dp</item> <!-- 圆角大小 -->
    </style>

    <style name="AppTheme.AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">@string/ad_attribution</item>
        <item name="android:background">#FFCC66</item>
        <item name="android:width">15dp</item>
        <item name="android:height">15dp</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
    </style>
</resources>