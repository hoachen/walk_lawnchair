<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局颜色属性 -->
    <attr name="progressColor" format="color" />
    <attr name="backgroundColor" format="color" />
    
    <!-- TaskProgressBar专用属性 -->
    <attr name="scaleTextColor" format="color" />
    <attr name="scaleTextSize" format="dimension" />
    <attr name="completedMarkerColor" format="color" />
    <attr name="progressHeight" format="dimension" />
    <attr name="textPadding" format="dimension" />
    <attr name="cornerRadius" format="dimension" />

    <declare-styleable name="ArcProgressBar">
        <attr name="progress" format="integer" />
        <attr name="max" format="integer" />
        <attr name="startAngle" format="float" />
        <attr name="sweepAngle" format="float" />
        <attr name="progressColor" />
        <attr name="backgroundColor" />
        <attr name="strokeWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="TaskProgressBar">
        <!-- 进度条颜色 -->
        <attr name="progressColor" />
        <attr name="backgroundColor" />
        
        <!-- 刻度文本颜色和大小 -->
        <attr name="scaleTextColor" />
        <attr name="scaleTextSize" />
        
        <!-- 已完成标记颜色 -->
        <attr name="completedMarkerColor" />
        
        <!-- 进度条高度 -->
        <attr name="progressHeight" />
        
        <!-- 文本间距 -->
        <attr name="textPadding" />
        
        <!-- 圆角半径 -->
        <attr name="cornerRadius" />
    </declare-styleable>

</resources>
