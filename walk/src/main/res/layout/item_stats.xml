<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="32dp"
    android:layout_marginTop="10dp">

    <!-- 距离数据 -->
    <TextView
        android:id="@+id/tv_distance_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00"
        android:textColor="?attr/colorOnBackground"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_calories_value"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_distance_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_distance_unit"
        android:textColor="?attr/colorOnBackground"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/tv_distance_value"
        app:layout_constraintStart_toStartOf="@+id/tv_distance_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_distance_value" />

    <!-- 卡路里数据 -->
    <TextView
        android:id="@+id/tv_calories_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="?attr/colorOnBackground"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tv_time_value"
        app:layout_constraintStart_toEndOf="@+id/tv_distance_value"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_calories_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_calories_unit"
        android:textColor="?attr/colorOnBackground"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/tv_calories_value"
        app:layout_constraintStart_toStartOf="@+id/tv_calories_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_calories_value" />

    <!-- 时间数据 -->
    <TextView
        android:id="@+id/tv_time_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="?attr/colorOnBackground"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_calories_value"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_time_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_duration_unit"
        android:textColor="?attr/colorOnBackground"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/tv_time_value"
        app:layout_constraintStart_toStartOf="@+id/tv_time_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_time_value" />

</androidx.constraintlayout.widget.ConstraintLayout>
