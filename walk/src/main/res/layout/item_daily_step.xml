<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="2dp">

    <!-- 柱状图容器 -->
    <FrameLayout
        android:id="@+id/barContainer"
        android:layout_width="16dp"
        android:layout_height="80dp"
        android:background="@drawable/progress_bar_background">

        <!-- 填充视图：从底部开始绘制 -->
        <View
            android:id="@+id/fillView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="@drawable/progress_bar_foreground" />
    </FrameLayout>

    <!-- 标签区域 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvDayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weekday_monday"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvStepValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/daily_step_value_sample"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
