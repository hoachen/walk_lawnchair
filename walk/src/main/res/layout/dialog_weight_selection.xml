<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/picker_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_dot"
            android:textSize="20sp" />

        <NumberPicker
            android:id="@+id/picker_weight_decimal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_unit_kg"
            android:textSize="16sp" />

    </LinearLayout>

    <RadioGroup
        android:id="@+id/radio_group_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radio_kg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/weight_unit_kg"
            android:textColor="?attr/colorOnSurface" />

        <RadioButton
            android:id="@+id/radio_lbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weight_unit_lbs"
            android:textColor="?attr/colorOnSurface" />

    </RadioGroup>

</LinearLayout> 