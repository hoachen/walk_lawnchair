<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 步数显示 -->
    <TextView
        android:id="@+id/tv_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="?attr/colorPrimary"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 每日步数文字 -->
    <TextView
        android:id="@+id/tv_daily_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/daily_steps"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/tv_steps"
        app:layout_constraintStart_toStartOf="@+id/tv_steps"
        app:layout_constraintTop_toBottomOf="@+id/tv_steps" />

    <!-- 图表按钮（暂时隐藏） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_chart"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:icon="@drawable/baseline_insert_chart_outlined_24"
        app:iconTint="?attr/colorOnBackground"
        app:layout_constraintEnd_toEndOf="@+id/tv_daily_steps"
        app:layout_constraintStart_toStartOf="@+id/tv_daily_steps"
        app:layout_constraintTop_toBottomOf="@+id/tv_daily_steps" />

    <!-- 宝箱图标 -->
    <ImageView
        android:id="@+id/icon_treasure"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/task_done_icon_treasure_close"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_steps"
        app:layout_constraintTop_toTopOf="@+id/tv_steps" />

</androidx.constraintlayout.widget.ConstraintLayout>
