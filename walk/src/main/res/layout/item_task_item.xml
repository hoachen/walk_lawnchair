<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/task_item_container"
    android:layout_width="160dp"
    android:layout_height="160dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/task_card_background"
    android:clipToPadding="false"
    android:elevation="4dp"
    android:padding="18dp">

    <!-- 顶部区域：步数和徽章 -->
    <LinearLayout
        android:id="@+id/top_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 步数区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="1,000" />

            <TextView
                android:id="@+id/tv_task_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:text="@string/task_item_subtitle_sample"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 金币徽章 -->
        <ImageView
            android:id="@+id/tv_task_badge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_dollar_display"/>
    </LinearLayout>

    <!-- 进度条 -->
    <FrameLayout
        android:id="@+id/progress_track"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/progress_track_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_container">

        <View
            android:id="@+id/progress_value"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/progress_value_background" />
    </FrameLayout>

    <!-- 操作按钮 - 使用普通View避免主题样式覆盖 -->
    <android.widget.Button
        android:id="@+id/btn_action"
        style="@android:style/Widget.DeviceDefault.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/task_button_primary_gradient"
        android:fontFamily="sans-serif"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:paddingVertical="10dp"
        android:stateListAnimator="@null"
        android:text="@string/task_item_action_button"
        android:textColor="@color/md_theme_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_track" />

</androidx.constraintlayout.widget.ConstraintLayout>
