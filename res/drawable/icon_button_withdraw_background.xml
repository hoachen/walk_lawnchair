<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 基础黄色背景 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/md_theme_tertiary" />
            <stroke
                android:width="1dp"
                android:color="@color/md_theme_tertiary" />
        </shape>
    </item>

    <!-- 左上角径向渐变：tertiaryContainer到tertiary -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0%"
                android:centerY="0%"
                android:endColor="@color/md_theme_tertiary"
                android:gradientRadius="58%"
                android:startColor="@color/md_theme_tertiaryContainer"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
